{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "helpers/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "probe-real-person.ts",
    "probe-silence.ts"
  ]
}
